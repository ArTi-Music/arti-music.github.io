<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ar.Ti Off The Wall 3D Carousel</title>
    <style>
        /* Forces the code to stay neatly grouped within the exact physical boundaries you give it in Wix */
        html, body {
            margin: 0;
            padding: 0;
            background-color: transparent;
            font-family: system-ui, -apple-system, sans-serif;
            width: 100%;
            height: 100%;
            overflow: visible;
        }

        /* The overall base box frame layout container */
        .stage-box-wrapper {
            position: relative;
            width: 100%;
            height: 580px; 
            display: flex;
            justify-content: flex-start;
            align-items: center;
            padding-left: 30px;
            box-sizing: border-box;
        }
        
        .slider-container {
            position: relative;
            width: 420px; 
            height: 500px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .slider-wrapper {
            position: relative;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }
        
        .slider-track {
            position: relative;
            width: 380px;  
            height: 540px; 
            transform-style: preserve-3d;
            display: flex;
            justify-content: center; 
            align-items: center;
        }
        
        .apparel-slide {
            position: absolute;
            width: 340px;  
            height: 460px; 
            border-radius: 14px;
            overflow: hidden;
            cursor: pointer;
            box-shadow: 0 25px 45px rgba(0, 0, 0, 0.65);
            background: #111111; 
            border: 1px solid rgba(255, 255, 255, 0.12);
            transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.5s, filter 0.5s;
        }
        
        .apparel-slide img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain; 
            pointer-events: none;
        }
        
        .audio-control-btn {
            position: absolute;
            bottom: 20px;
            left: 30px; 
            background: #000000; 
            color: #FFFFFF;
            border: 1px solid rgba(255, 255, 255, 0.4);
            padding: 12px 24px;
            border-radius: 25px;
            font-size: 0.9rem;
            font-weight: bold;
            cursor: pointer;
            z-index: 900;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }

        /* ==========================================================================
           SAFE POPUP MODAL SCREEN OVERLAY LAYERS (CONTAINED INSIDE THE WIX BOX)
           ========================================================================== */
        .detail-popup-overlay {
            display: none; 
            position: absolute; /* FIXED: Prevents stretching across the whole live site screen layout */
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(8px);
            z-index: 2000; 
            justify-content: center;
            align-items: center;
            border-radius: 16px;
        }
        
        .popup-card {
            background: #121212;
            border: 1px solid rgba(255, 255, 255, 0.15);
            width: 90%;
            height: 85%;
            display: flex;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(0,0,0,0.9);
            position: relative;
            border-radius: 12px;
        }
        
        .popup-img-side {
            width: 50%;
            background: #000000;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 15px;
            box-sizing: border-box;
        }
        
        .popup-img-side img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        
        .popup-info-side {
            width: 50%;
            padding: 30px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            background: #141414;
        }
        
        .popup-close-trigger {
            position: absolute;
            top: 10px;
            right: 15px;
            background: transparent;
            color: #888888;
            border: none;
            font-size: 2rem;
            cursor: pointer;
            z-index: 2010;
        }
        
        .popup-close-trigger:hover { color: #FFFFFF; }
        
        .popup-title-text {
            color: #FFFFFF;
            font-size: 1.6rem;
            margin: 0 0 8px 0;
            font-weight: bold;
        }
        
        .popup-price-text {
            color: #C0C0C0;
            font-size: 1.2rem;
            font-weight: 600;
            margin: 0 0 20px 0;
        }
        
        .product-details-link {
            font-size: 1rem;
            color: #ff3333; 
            text-transform: uppercase;
            font-weight: bold;
            letter-spacing: 1px;
            text-decoration: none;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            padding-bottom: 2px;
            display: inline-block;
        }
        
        .product-details-link:hover {
            color: #FFFFFF;
            border-bottom: 2px solid #FFFFFF;
        }

        @media (max-width: 768px) {
            .stage-box-wrapper { padding-left: 0; justify-content: center; height: auto; }
            .popup-card { flex-direction: column; }
            .popup-img-side { width: 100%; height: 45%; }
            .popup-info-side { width: 100%; height: 55%; padding: 20px; }
        }
    </style>
</head>
<body>

    <audio id="bg-audio-player" loop crossorigin="anonymous">
        <source src="https://static.wixstatic.com/mp3/d89c2f_2a28902ec8cb46199d53e47f4098e2a0.mp3" type="audio/mpeg">
    </audio>
    
    <div class="stage-box-wrapper" id="slider-hover-zone">
        
        <button class="audio-control-btn" id="audio-toggle" onclick="toggleStreetAudio(event)">
            PLAY BEAT
        </button>
        
        <div class="slider-container">
            <div class="slider-wrapper">
                <div class="slider-track" id="apparel-track">
                    
                    <!-- Direct onclick bindings added so clicks fire without relying on complex listeners -->
                    <div class="apparel-slide" data-index="0" onclick="handleSlideSelection(this, 0, event)"
                         data-title="Arcade Tee (White)" 
                         data-price="$93.48" 
                         data-link="https://rofaiva.co.nz">
                        <img src="https://wixstatic.com" alt="Product 1">
                    </div>
                    <div class="apparel-slide" data-index="1" onclick="handleSlideSelection(this, 1, event)"
                         data-title="Arcade Hood" 
                         data-price="$101.98" 
                         data-link="https://rofaiva.co.nz">
                        <img src="https://wixstatic.com" alt="Product 2">
                    </div>
                    <div class="apparel-slide" data-index="2" onclick="handleSlideSelection(this, 2, event)"
                         data-title="Arcade Tee (Grey)" 
                         data-price="$93.48" 
                         data-link="https://rofaiva.co.nz">
                        <img src="https://wixstatic.com" alt="Product 3">
                    </div> 
                    <div class="apparel-slide" data-index="3" onclick="handleSlideSelection(this, 3, event)"
                         data-title="Arcade Longsleeve" 
                         data-price="$93.48" 
                         data-link="https://rofaiva.co.nz">
                        <img src="https://wixstatic.com" alt="Product 4">
                    </div> 
                    <div class="apparel-slide" data-index="4" onclick="handleSlideSelection(this, 4, event)"
                         data-title="Arcade Tee (Back)" 
                         data-price="$93.48" 
                         data-link="https://rofaiva.co.nz">
                        <img src="https://wixstatic.com" alt="Product 5">
                    </div> 
                    
                </div>
            </div>
        </div>

        <!-- Pop-up Overlay contained perfectly inside the block element limits -->
        <div class="detail-popup-overlay" id="popup-overlay" onclick="handleOverlayBackgroundClick(event)">
            <div class="popup-card">
                <button class="popup-close-trigger" onclick="forceClosePopup(event)">&times;</button>
                <div class="popup-img-side">
                    <img id="popup-display-img" src="" alt="Selected Product Visual">
                </div>
                <div class="popup-info-side">
                    <h2 class="popup-title-text" id="popup-display-title">Product Name</h2>
